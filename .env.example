FLASK_ENV=development
HOST=127.0.0.1
PORT=5050

SMART_MIRROR_NAME=Batuhan
CITY=Weingarten
# Recommended: exact coordinates (right-click your home in Apple/Google Maps and copy them).
# If empty, the city name is looked up automatically, which can pick the wrong town.
LATITUDE=
LONGITUDE=

# Empty = use the system timezone. Example: Europe/Berlin
TIMEZONE=
# Date language: en-GB gives "14 October Wednesday", tr-TR gives "14 Ekim Çarşamba"
DISPLAY_LOCALE=en-GB
# Set to true on the Raspberry Pi kiosk
HIDE_CURSOR=false

# mock | raspberrypi
HARDWARE_MODE=mock
# openmeteo (real data) | mock (offline development)
WEATHER_SOURCE=openmeteo
# Phase 1 testing only: playing | idle
MOCK_SPOTIFY_STATE=playing

# Spotify (Phase 3). Create an app at https://developer.spotify.com/dashboard
# auto = real Spotify when client id and secret are set, otherwise mock
SPOTIFY_SOURCE=auto
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the redirect URI in the Spotify dashboard exactly. Use 127.0.0.1, not localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5050/spotify/callback

# Used from Phase 4 onward
APPLE_USERNAME=
APPLE_APP_PASSWORD=
